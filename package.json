{
  "name": "no-more-skill",
  "version": "0.4.6",
  "description": "NMS: behavior engineering + execution harness",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/**",
    "!dist/releases/**",
    "skills/**",
    "agents/**",
    ".claude-plugin/**",
    "SKILL.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "bin": {
    "nms": "dist/cli.js",
    "nms-skill": "dist/skill-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "dev:skill": "tsx src/skill-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:pack": "node scripts/release/pack-skill.mjs",
    "release:validate": "node scripts/release/validate-release.mjs",
    "release:smoke": "node scripts/release/smoke-install.mjs",
    "release:check": "npm run build && npm test && npm run release:validate && npm run release:smoke"
  },
  "keywords": [
    "cli",
    "ai",
    "workflow",
    "harness"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "commander": "^14.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "adm-zip": "^0.5.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
